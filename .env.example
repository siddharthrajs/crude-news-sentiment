# SQLite for local dev; Postgres on Coolify
DATABASE_URL=sqlite:///./data/cns.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/cns

POLL_INTERVAL_SECONDS=90
FEED_URL=https://www.financialjuice.com/feed.ashx?xy=rss
HTTP_TIMEOUT_SECONDS=25
USER_AGENT=crude-news-sentiment/0.1

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Bump when scoring logic changes; old scores are retained under the old version.
SCORER_VERSION=v0
INDEX_WINDOW_DAYS=7
INDEX_HALF_LIFE_HOURS=24
INDEX_SNAPSHOT_INTERVAL_MINUTES=60

# Keep headlines the filters reject, labelled but excluded from scoring.
# On by default: discards are unrecoverable (100-item feed window) and the
# rejects are the negative examples the relevance lexicon is tuned against.
STORE_IRRELEVANT=true

# Zero-shot relevance: a second opinion alongside the lexicon. Needs the ml
# extra (~2GB torch) - build with INSTALL_ML=1. Advisory only; it never
# overwrites category, it only records where the two disagree.
ZEROSHOT_ENABLED=false
ZEROSHOT_MODEL=facebook/bart-large-mnli
ZEROSHOT_THRESHOLD=0.80
ZEROSHOT_INTERVAL_MINUTES=5
